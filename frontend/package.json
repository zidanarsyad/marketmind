{
  "name": "marketmind-web",
  "version": "1.0.0",
  "private": true,
  "description": "Vue 3 front end for the MarketMind multi-agent market research system",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@primeuix/themes": "2.0.3",
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "plotly.js-cartesian-dist-min": "^4.1.1",
    "primeicons": "7.0.0",
    "primevue": "4.5.5",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
