# Copy this file to `.env` and fill in ONE of the free options below.
# Without any key the system still runs end-to-end in offline (deterministic) mode.

# auto = use the first key found below; or force one of: gemini | groq | openrouter | ollama | openai_compatible | anthropic | none
LLM_PROVIDER=auto
# Optional model override (each provider has a sensible default; retired models are replaced automatically)
LLM_MODEL=

# --- Free options --------------------------------------------------------------------------
# Google AI Studio (Gemini) free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq free tier (very fast Llama/Qwen models): https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter free models (":free" suffix): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Ollama runs models locally for free (no key): https://ollama.com  -> then set LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Any other OpenAI-compatible endpoint ---------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=

# --- Claude (paid) via the official Anthropic SDK; default model claude-opus-5-5 --------------
ANTHROPIC_API_KEY=

# --- Optional live news headlines for the Data Collection Agent (free tiers) -----------------
# https://gnews.io  or  https://newsapi.org
GNEWS_API_KEY=
NEWSAPI_KEY=

# Seconds between LLM calls (free tiers have per-minute limits); provider defaults apply when empty
LLM_MIN_INTERVAL=
