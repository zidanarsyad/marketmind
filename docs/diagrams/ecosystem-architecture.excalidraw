    {"type": "text", "id": "ev1_head", "x": 1960, "y": 190, "width": 340, "height": 18, "text": "MaklonNusa rejects its slice of the plan", "originalText": "MaklonNusa rejects its slice of the plan", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "roughness": 0, "opacity": 100, "seed": 6002, "containerId": null, "lineHeight": 1.25},
    {"type": "rectangle", "id": "ev1_box", "x": 1960, "y": 214, "width": 440, "height": 242, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100, "roundness": {"type": 3}, "seed": 6003},
    {"type": "text", "id": "ev1_json", "x": 1976, "y": 228, "width": 336, "height": 211, "text": "{\n  \"message_id\": \"MAK-0035\",\n  \"sender\": \"maklonnusa.capacity_planner\",\n  \"receiver\": \"control.coordinator\",\n  \"message_type\": \"REJECT_PROPOSAL\",\n  \"task\": \"plan\",\n  \"payload\": {\n    \"max_batches\": {\"6\": 2},\n    \"reason\": \"line reliability forecast\"\n  },\n  \"in_reply_to\": \"CON-0077\",\n  \"week\": 5\n}", "originalText": "{\n  \"message_id\": \"MAK-0035\",\n  \"sender\": \"maklonnusa.capacity_planner\",\n  \"receiver\": \"control.coordinator\",\n  \"message_type\": \"REJECT_PROPOSAL\",\n  \"task\": \"plan\",\n  \"payload\": {\n    \"max_batches\": {\"6\": 2},\n    \"reason\": \"line reliability forecast\"\n  },\n  \"in_reply_to\": \"CON-0077\",\n  \"week\": 5\n}", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "roughness": 0, "opacity": 100, "seed": 6004, "containerId": null, "lineHeight": 1.25},
    {"type": "text", "id": "ev1_cap", "x": 1960, "y": 466, "width": 340, "height": 45, "text": "Its breakdown model saw filling line 2 failing\nin W6 (p = 0.54). It shares the limit; the\nmaintenance log never leaves its server.", "originalText": "Its breakdown model saw filling line 2 failing\nin W6 (p = 0.54). It shares the limit; the\nmaintenance log never leaves its server.", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "roughness": 0, "opacity": 100, "seed": 6005, "containerId": null, "lineHeight": 1.25},

    {"type": "text", "id": "ev2_head", "x": 1960, "y": 560, "width": 310, "height": 18, "text": "Each dialect, translated at the gate", "originalText": "Each dialect, translated at the gate", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "roughness": 0, "opacity": 100, "seed": 6006, "containerId": null, "lineHeight": 1.25},
    {"type": "rectangle", "id": "ev2_box", "x": 1960, "y": 584, "width": 440, "height": 128, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100, "roundness": {"type": 3}, "seed": 6007},
    {"type": "text", "id": "ev2_text", "x": 1976, "y": 598, "width": 320, "height": 98, "text": "freeCapacity.batchesByWeek[\"6\"] = 4\n  → maklon_capacity[6] = 20,000 units\nlanes.JKT[\"2027-W01\"] = 13 pallets\n  → lane_capacity.JKT[7] = 15,600 units\nprediksi_tingkat_cacat[\"5\"] = 0.0772\n  → defect_rate[5] = 7.7%", "originalText": "freeCapacity.batchesByWeek[\"6\"] = 4\n  → maklon_capacity[6] = 20,000 units\nlanes.JKT[\"2027-W01\"] = 13 pallets\n  → lane_capacity.JKT[7] = 15,600 units\nprediksi_tingkat_cacat[\"5\"] = 0.0772\n  → defect_rate[5] = 7.7%", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "roughness": 0, "opacity": 100, "seed": 6008, "containerId": null, "lineHeight": 1.25},

    {"type": "text", "id": "ev3_head", "x": 1960, "y": 752, "width": 240, "height": 18, "text": "The coordinator's objective", "originalText": "The coordinator's objective", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "roughness": 0, "opacity": 100, "seed": 6009, "containerId": null, "lineHeight": 1.25},
    {"type": "rectangle", "id": "ev3_box", "x": 1960, "y": 776, "width": 440, "height": 142, "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100, "roundness": {"type": 3}, "seed": 6010},
    {"type": "text", "id": "ev3_text", "x": 1976, "y": 790, "width": 290, "height": 114, "text": "min  w_C·cost + w_T·time\n   + w_R·risk + w_Q·lost service\ns.t. batches ≤ free capacity\n       (whole batches of 5,000)\n     shipped ≤ lane capacity\n     made ≤ good packaging sets\n     stock + short ≥ commitment", "originalText": "min  w_C·cost + w_T·time\n   + w_R·risk + w_Q·lost service\ns.t. batches ≤ free capacity\n       (whole batches of 5,000)\n     shipped ≤ lane capacity\n     made ≤ good packaging sets\n     stock + short ≥ commitment", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "roughness": 0, "opacity": 100, "seed": 6011, "containerId": null, "lineHeight": 1.25},

    {"type": "text", "id": "ev4_head", "x": 1960, "y": 962, "width": 280, "height": 18, "text": "Every disruption, same customers", "originalText": "Every disruption, same customers", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "roughness": 0, "opacity": 100, "seed": 6012, "containerId": null, "lineHeight": 1.25},
    {"type": "rectangle", "id": "bar_local", "x": 1960, "y": 990, "width": 333, "height": 34, "strokeColor": "#1e40af", "backgroundColor": "#dbeafe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "roundness": {"type": 3}, "seed": 6013},
    {"type": "text", "id": "bar_local_t", "x": 1972, "y": 999, "width": 252, "height": 16, "text": "local intelligence: 75.6% served", "originalText": "local intelligence: 75.6% served", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "roughness": 0, "opacity": 100, "seed": 6014, "containerId": null, "lineHeight": 1.25},
    {"type": "rectangle", "id": "bar_eco", "x": 1960, "y": 1034, "width": 424, "height": 34, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "opacity": 100, "roundness": {"type": 3}, "seed": 6015},
    {"type": "text", "id": "bar_eco_t", "x": 1972, "y": 1043, "width": 284, "height": 16, "text": "ecosystem intelligence: 96.4% served", "originalText": "ecosystem intelligence: 96.4% served", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "roughness": 0, "opacity": 100, "seed": 6016, "containerId": null, "lineHeight": 1.25},
    {"type": "text", "id": "ev4_cap", "x": 1960, "y": 1080, "width": 345, "height": 30, "text": "Profit of all six: Rp 10.9 bn alone, Rp 14.0 bn\ntogether; every enterprise earns more.", "originalText": "Profit of all six: Rp 10.9 bn alone, Rp 14.0 bn\ntogether; every enterprise earns more.", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "roughness": 0, "opacity": 100, "seed": 6017, "containerId": null, "lineHeight": 1.25},

