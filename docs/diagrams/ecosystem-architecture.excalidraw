    {"type": "text", "id": "title", "x": 60, "y": 36, "width": 1140, "height": 38, "text": "MarketMind ecosystem: six enterprises around one Control Center", "originalText": "MarketMind ecosystem: six enterprises around one Control Center", "fontSize": 30, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "roughness": 0, "opacity": 100, "seed": 1001, "containerId": null, "lineHeight": 1.25},
    {"type": "text", "id": "subtitle", "x": 60, "y": 84, "width": 1270, "height": 40, "text": "Kirana Beauty launches a moisturizer through 12.12 and Ramadan 2027. Each enterprise is its own server, database, agents and rules;\nagents talk peer to peer over A2A, and the Control Center plans only from what each governance gate lets through.", "originalText": "Kirana Beauty launches a moisturizer through 12.12 and Ramadan 2027. Each enterprise is its own server, database, agents and rules;\nagents talk peer to peer over A2A, and the Control Center plans only from what each governance gate lets through.", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "roughness": 0, "opacity": 100, "seed": 1002, "containerId": null, "lineHeight": 1.25},
