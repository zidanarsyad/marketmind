{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketmind.local/schemas/datasets/survey_response_row.schema.json",
  "title": "SurveyResponseRow",
  "description": "One row of consumer_survey.csv after quality screening (speeders, straight-liners, failed attention checks and invalid ages removed).",
  "type": "object",
  "$defs": {
    "likert": {"type": "integer", "minimum": 1, "maximum": 5},
    "flag": {"type": "integer", "enum": [0, 1]},
    "price": {"type": "integer", "minimum": 5000}
  },
  "required": [
    "respondent_id", "survey_date", "age", "gender", "region", "city_tier", "occupation", "income_bracket", "monthly_income_idr",
    "monthly_skincare_spend_idr", "routine_steps", "purchase_freq_per_month", "skin_type", "primary_concern", "preferred_channel",
    "main_brand", "nps_main_brand", "satisfaction_main_brand", "social_media_hours_per_day", "primary_platform",
    "follows_skincare_influencers", "influencer_trust", "imp_price", "imp_halal", "imp_ingredients", "imp_brand_reputation",
    "imp_packaging", "imp_reviews_influencers", "imp_local_brand", "imp_sustainability", "imp_fragrance_free", "imp_fast_results",
    "attention_check", "concept_purchase_intent", "vw_too_cheap_idr", "vw_cheap_idr", "vw_expensive_idr", "vw_too_expensive_idr",
    "completion_time_sec"
  ],
  "properties": {
    "respondent_id": {"type": "string", "pattern": "^S[0-9]{5}$"},
    "survey_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "age": {"type": "integer", "minimum": 15, "maximum": 75},
    "gender": {"type": "string", "enum": ["Female", "Male"]},
    "region": {"type": "string", "minLength": 1},
    "city_tier": {"type": "string", "enum": ["Tier 1", "Tier 2", "Tier 3"]},
    "occupation": {"type": "string", "enum": ["Student", "Employee", "Freelancer", "Entrepreneur", "Housewife", "Civil servant"]},
    "income_bracket": {"type": ["string", "null"], "enum": ["< Rp3 jt", "Rp3-5 jt", "Rp5-10 jt", "Rp10-20 jt", "> Rp20 jt", null]},
    "monthly_income_idr": {"type": ["number", "null"], "minimum": 0},
    "monthly_skincare_spend_idr": {"$ref": "#/$defs/price"},
    "routine_steps": {"type": "integer", "minimum": 1, "maximum": 7},
    "purchase_freq_per_month": {"type": "number", "minimum": 0.3, "maximum": 4},
    "skin_type": {"type": "string", "enum": ["oily", "dry", "combination", "sensitive", "normal"]},
    "primary_concern": {
      "type": "string",
      "enum": ["Acne & breakouts", "Oil control", "Dullness", "Dark spots", "Fine lines & aging", "Dryness & barrier", "Sensitivity & redness"]
    },
    "preferred_channel": {"type": "string", "enum": ["Shopee", "Tokopedia", "TikTok Shop", "Lazada", "Offline Retail"]},
    "main_brand": {"type": "string", "minLength": 1},
    "aware_kirana": {"$ref": "#/$defs/flag"},
    "aware_lumiere": {"$ref": "#/$defs/flag"},
    "aware_dewiskin": {"$ref": "#/$defs/flag"},
    "aware_glownesia": {"$ref": "#/$defs/flag"},
    "aware_aurelia": {"$ref": "#/$defs/flag"},
    "aware_purabotanica": {"$ref": "#/$defs/flag"},
    "nps_main_brand": {"type": "integer", "minimum": 0, "maximum": 10},
    "satisfaction_main_brand": {"$ref": "#/$defs/likert"},
    "social_media_hours_per_day": {"type": "number", "minimum": 0, "maximum": 24},
    "primary_platform": {"type": "string", "enum": ["TikTok", "Instagram", "YouTube", "Facebook", "X"]},
    "follows_skincare_influencers": {"type": "boolean"},
    "influencer_trust": {"$ref": "#/$defs/likert"},
    "imp_price": {"$ref": "#/$defs/likert"},
    "imp_halal": {"$ref": "#/$defs/likert"},
    "imp_ingredients": {"$ref": "#/$defs/likert"},
    "imp_brand_reputation": {"$ref": "#/$defs/likert"},
    "imp_packaging": {"$ref": "#/$defs/likert"},
    "imp_reviews_influencers": {"$ref": "#/$defs/likert"},
    "imp_local_brand": {"$ref": "#/$defs/likert"},
    "imp_sustainability": {"$ref": "#/$defs/likert"},
    "imp_fragrance_free": {"$ref": "#/$defs/likert"},
    "imp_fast_results": {"$ref": "#/$defs/likert"},
    "attention_check": {"const": 4, "description": "Instructed-response item; screened rows always answered 4."},
    "concept_purchase_intent": {"$ref": "#/$defs/likert"},
    "vw_too_cheap_idr": {"$ref": "#/$defs/price"},
    "vw_cheap_idr": {"$ref": "#/$defs/price"},
    "vw_expensive_idr": {"$ref": "#/$defs/price"},
    "vw_too_expensive_idr": {"$ref": "#/$defs/price"},
    "completion_time_sec": {"type": "integer", "minimum": 0}
  }
}
